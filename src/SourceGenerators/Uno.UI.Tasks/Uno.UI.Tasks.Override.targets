<Project>
	<!--
		NuGet override (UnoNugetOverrideVersion): points an overridden uno.winui package's targets at the locally built tasks.

		A published package's tasks are built with the commit SHA in place of "v0" (UpdateTasksSHA in build/Uno.UI.Build.csproj): the
		assembly is Uno.UI.Tasks.<sha>.dll, the task types are named <Task>_<sha>, and the package's targets load them by those names.
		Locally built tasks keep "v0", so every targets and props file under the package's buildTransitive folder that uses the SHA is
		switched over to "v0". The SHA is looked up in each of those files (an assembly name or a task name using it), so files that a
		previous, possibly interrupted, override already switched are left alone and the remaining ones are still found.
	-->
	<Target Name="_UnoPointOverriddenPackageAtLocalTasks" Condition="'$(UnoNugetOverrideVersion)'!=''">
		<PropertyGroup>
			<_UnoOverriddenTasksPackageFolder Condition="'$(_UnoOverriddenTasksPackageFolder)'==''">$(NuGetPackageRoot)\uno.winui\$(UnoNugetOverrideVersion)</_UnoOverriddenTasksPackageFolder>
			<_UnoPackageTasksSuffixPattern>(?&lt;=Uno\.UI\.Tasks\.|_)[0-9a-f]{40}(?![0-9a-f])</_UnoPackageTasksSuffixPattern>
		</PropertyGroup>

		<ItemGroup>
			<_UnoPackageTasksFile Include="$(_UnoOverriddenTasksPackageFolder)\buildTransitive\**\*.targets;$(_UnoOverriddenTasksPackageFolder)\buildTransitive\**\*.props" />
			<_UnoPackageTasksSuffixReference Include="$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('%(_UnoPackageTasksFile.FullPath)')), '$(_UnoPackageTasksSuffixPattern)'))" />
		</ItemGroup>

		<PropertyGroup>
			<_UnoPackageTasksSuffix>@(_UnoPackageTasksSuffixReference->Distinct())</_UnoPackageTasksSuffix>
		</PropertyGroup>

		<!-- Any SHA left after switching this one, in the same file or another, means the targets use more than one. -->
		<ItemGroup Condition="'$(_UnoPackageTasksSuffix)' != ''">
			<_UnoPackageTasksOtherSuffixFile Include="@(_UnoPackageTasksFile)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)').Replace('$(_UnoPackageTasksSuffix)', 'v0')), '$(_UnoPackageTasksSuffixPattern)'))" />
		</ItemGroup>

		<Error Text="The overridden package's targets load Uno.UI.Tasks with more than one commit SHA, they can't be pointed at the v0 tasks: @(_UnoPackageTasksOtherSuffixFile->'%(RecursiveDir)%(Filename)%(Extension)', ', ')" Condition="'@(_UnoPackageTasksOtherSuffixFile)' != ''" />

		<ItemGroup Condition="'$(_UnoPackageTasksSuffix)' != ''">
			<_UnoPackageTasksBoundFile Include="@(_UnoPackageTasksFile)" Condition="$([System.IO.File]::ReadAllText('%(FullPath)').Contains('$(_UnoPackageTasksSuffix)'))" />
		</ItemGroup>

		<Message Importance="high"
				 Text="Pointing the package targets at the v0 tasks instead of the package's $(_UnoPackageTasksSuffix) tasks: @(_UnoPackageTasksBoundFile->'%(RecursiveDir)%(Filename)%(Extension)', ', ')"
				 Condition="'@(_UnoPackageTasksBoundFile)' != ''" />
		<WriteLinesToFile File="%(_UnoPackageTasksBoundFile.FullPath)"
						  Lines="$([MSBuild]::Escape($([System.IO.File]::ReadAllText('%(_UnoPackageTasksBoundFile.FullPath)').Replace('$(_UnoPackageTasksSuffix)', 'v0').TrimEnd())))"
						  Overwrite="true"
						  Condition="'@(_UnoPackageTasksBoundFile)' != ''" />
	</Target>
</Project>
